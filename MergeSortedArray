class Solution {
    int[] nums;
    public void merge(int[] nums1, int m, int[] nums2, int n) 
    {
        int size=m+n;
        nums = new int[size];

        for(int i=0;i<m;i++)
        {
            nums[i]=nums1[i];

        }
        for(int i=0;i<n;i++)
        {
            nums[m+i]=nums2[i];
        }
        for(int i=0;i<nums.length;i++)
        {
            for(int j=i;j<nums.length;j++)
            {
                if(nums[i]>nums[j])
                {
                    int temp=nums[i];
                    nums[i]=nums[j];
                    nums[j]=temp;
                }
            }
        }

        for(int i=0;i<nums.length;i++)
        {
            nums1[i]=nums[i];
        }
    }
}
